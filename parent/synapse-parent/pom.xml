<!--
    Parent POM for applications built with Synapse. Brings Spring Boot (via spring-boot-starter-parent),
    the Synapse BOM and Synapse's build conventions for consumer projects.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Keep in sync with spring-boot.version in the root pom.xml. -->
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.americanexpress.synapse</groupId>
    <artifactId>synapse-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>Parent POM for applications built with Synapse.</description>
    <url>https://github.com/americanexpress/synapse</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>American Express Travel Related Services, Inc.</name>
            <organizationUrl>https://americanexpress.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/americanexpress/synapse</url>
        <connection>scm:git:https://github.com/americanexpress/synapse.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/americanexpress/synapse.git</developerConnection>
    </scm>

    <properties>
        <!-- Minimum Java for Synapse applications; consumers may raise it. -->
        <java.version>21</java.version>
        <!--
            Must equal this POM's own version (checked by the enforcer below). It can't be ${project.version}, which
            would resolve to the consumer's version. release-please updates the marked line.
        -->
        <synapse.version>2.0.0-SNAPSHOT</synapse.version> <!-- x-release-please-version -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.americanexpress.synapse</groupId>
                <artifactId>synapse-bom</artifactId>
                <version>${synapse.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Lets `./mvnw spotless:apply|check` run from the repo root. Not inherited by consumer projects. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.10.4</version>
                <inherited>false</inherited>
            </plugin>
            <!-- Fails the build if synapse.version drifts from this POM's version. Not inherited by consumers. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>synapse-version-matches</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireProperty>
                                    <property>synapse.version</property>
                                    <regex>\Q${project.version}\E</regex>
                                    <regexMessage>synapse.version must equal the synapse-parent version (${project.version}).</regexMessage>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
