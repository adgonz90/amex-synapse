<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>synapse-api-grpc</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>
        Synapse gRPC API plugin: exposes operations as gRPC services on Spring Boot's gRPC server, with an edge that
        handles correlation, deadlines, concurrency and errors.
    </description>

    <properties>
        <!-- Code generated by protoc and grpc-java is marked @com.google.protobuf.Generated and @GrpcGenerated, which
             -XepDisableWarningsInGeneratedCode doesn't recognize; skip it in Error Prone (NullAway's OnlyNullMarked
             skips it already). -->
        <synapse.errorprone.excludedPaths>.*/target/generated-.*</synapse.errorprone.excludedPaths>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-core</artifactId>
        </dependency>
        <!-- Boot's spring-boot-starter-grpc-server without the starter (and its logging backend). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-grpc-server</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-services</artifactId>
        </dependency>
        <!-- io.grpc.stub.ServerCalls binds each compiled method; spring-grpc-core declares grpc-stub optional. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <!-- Brings proto-google-common-protos (com.google.rpc.*) at grpc-java's version. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-grpc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-grpc-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Binding check fixtures: an operation that returns a @jakarta.persistence.Entity. -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The servlet transport check: a GrpcServletRegistration bean needs the Servlet API. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The exception-handler order with Spring Security's gRPC handler, which Boot's gRPC security
             auto-configuration adds when spring-security-config is present. Unit tests only: the failsafe
             configuration below keeps it off the integration tests' class path. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-config</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generates the test fixture's messages and stubs from src/test/proto (one of the plugin's defaults). -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-test</id>
                        <goals>
                            <goal>generate-test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Integration tests run as a consumer's service would, without Spring Security: with it on the class
                 path, Boot's gRPC security auto-configuration and Spring Security's exception handler would run in
                 every test context. Only SynapseGrpcErrorAutoConfigurationTest, a unit test, needs it. The forked JVM
                 of GrpcContextExitOnRefreshIT inherits this class path. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.springframework.security:spring-security-config</classpathDependencyExclude>
                        <classpathDependencyExclude>org.springframework.security:spring-security-core</classpathDependencyExclude>
                        <classpathDependencyExclude>org.springframework.security:spring-security-crypto</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
