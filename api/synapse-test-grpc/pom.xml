<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>synapse-test-grpc</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>
        gRPC test slice for Synapse services: @SynapseGrpcTest starts the gRPC plugin with the application's bindings
        and hand-written services on Spring Boot's in-process test transport, with no network server.
    </description>

    <properties>
        <!-- A synapse-test-<plugin> artifact: it exports test libraries (Spring test, Boot's gRPC test transport) in
             compile scope. -->
        <synapse.enforcer.allowTestLibraries>true</synapse.enforcer.allowTestLibraries>
        <!-- The test fixture's code generated by protoc and grpc-java is marked @com.google.protobuf.Generated and
             @GrpcGenerated, which -XepDisableWarningsInGeneratedCode doesn't recognize; skip it in Error Prone
             (NullAway's OnlyNullMarked skips it already). -->
        <synapse.errorprone.excludedPaths>.*/target/generated-.*</synapse.errorprone.excludedPaths>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test</artifactId>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-api-grpc</artifactId>
        </dependency>
        <!-- @AutoConfigureTestGrpcTransport: the in-process server and the channel factory that reaches it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-grpc-test</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
        </dependency>
        <!-- The client stubs the tests call; spring-grpc-core declares grpc-stub optional. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- MissingGrpcMockIT and UnboundMethodIT launch a @SynapseGrpcTest class whose context must fail, and
                 inspect the failure. -->
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generates the test fixture's messages and stubs from src/test/proto (one of the plugin's defaults). -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-test</id>
                        <goals>
                            <goal>generate-test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
