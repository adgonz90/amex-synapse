<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
    Synapse Java code style (Eclipse JDT formatter profile).

    Used by Spotless in the build, and importable by IDEs:
      - VS Code (Java extension): "java.format.settings.url": ".config/synapse-java-format.xml",
                                  "java.format.settings.profile": "Synapse"
      - Eclipse: Preferences > Java > Code Style > Formatter > Import
      - IntelliJ IDEA: Settings > Editor > Code Style > Java > Import Scheme > Eclipse XML Profile

    Intent: 4-space indent, 120 columns, long call chains broken one call per line, and lenient where style is a
    matter of taste. Developer-chosen line breaks and blank lines are preserved, and comments are never reflowed.
    Settings not listed here use the Eclipse defaults.
-->
<profiles version="23">
    <profile kind="CodeFormatterProfile" name="Synapse" version="23">
        <!-- Language level the formatter parses (records, switch patterns, text blocks). -->
        <setting id="org.eclipse.jdt.core.compiler.source" value="21"/>
        <setting id="org.eclipse.jdt.core.compiler.compliance" value="21"/>
        <setting id="org.eclipse.jdt.core.compiler.codegen.targetPlatform" value="21"/>

        <!-- Indentation: 4 spaces; wrapped lines indent by two levels (8 spaces). -->
        <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
        <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="4"/>
        <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="4"/>
        <setting id="org.eclipse.jdt.core.formatter.continuation_indentation" value="2"/>
        <setting id="org.eclipse.jdt.core.formatter.continuation_indentation_for_array_initializer" value="2"/>
        <setting id="org.eclipse.jdt.core.formatter.indent_switchstatements_compare_to_switch" value="true"/>

        <!-- Line length. -->
        <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="120"/>
        <setting id="org.eclipse.jdt.core.formatter.comment.line_length" value="120"/>

        <!-- Leniency: keep line breaks and blank lines the author chose (up to one blank line). -->
        <setting id="org.eclipse.jdt.core.formatter.join_wrapped_lines" value="false"/>
        <setting id="org.eclipse.jdt.core.formatter.number_of_empty_lines_to_preserve" value="1"/>

        <!-- Comments: never reflow Javadoc, block or line comments. -->
        <setting id="org.eclipse.jdt.core.formatter.comment.format_javadoc_comments" value="false"/>
        <setting id="org.eclipse.jdt.core.formatter.comment.format_block_comments" value="false"/>
        <setting id="org.eclipse.jdt.core.formatter.comment.format_line_comments" value="false"/>
        <setting id="org.eclipse.jdt.core.formatter.comment.format_header" value="false"/>
        <setting id="org.eclipse.jdt.core.formatter.join_lines_in_comments" value="false"/>

        <!-- Escape hatch for hand-aligned code: // @formatter:off ... // @formatter:on -->
        <setting id="org.eclipse.jdt.core.formatter.use_on_off_tags" value="true"/>

        <!--
            Wrapping (Eclipse alignment codes: 16 = wrap where necessary, 48 = if wrapping is needed, put every
            element on its own line). Call chains that don't fit go one call per line.
        -->
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_selector_in_method_invocation" value="48"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_method_invocation" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_allocation_expression" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_parameters_in_method_declaration" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_parameters_in_constructor_declaration" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_record_components" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_superinterfaces_in_type_declaration" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_throws_clause_in_method_declaration" value="16"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_enum_constants" value="48"/>
        <setting id="org.eclipse.jdt.core.formatter.wrap_before_binary_operator" value="true"/>
    </profile>
</profiles>
