<!--
    Integration tests of synapse-data-jpa and synapse-data-jdbc on one class path: each module's own tests have only
    one access module, so that a store with access AUTO resolves there. It also starts stores beside an API plugin
    (gRPC), whose auto-configuration the data modules' own tests don't have. It has test sources only. Never published.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>synapse-data-mixed-tests</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Integration tests of the Synapse JPA and JDBC data modules together. Not published.</description>

    <properties>
        <!-- Tests only: never installed or deployed (which also keeps it out of the release SBOM), and no source or
             Javadoc jars. -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <!-- Without main sources the java-module profile is off, so JaCoCo's prepare-agent never sets argLine (there
             is no code to cover). The Mockito agent argument comes from the two executions below, as in that
             profile; spring-boot-starter-test brings Mockito. -->
        <argLine></argLine>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-data-jpa</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-data-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- StoresWithGrpcTest: stores in a service with the gRPC plugin, whose auto-configuration evaluates an
                 annotation-based @ConditionalOnBean before Synapse's JPA auto-configuration. -->
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-api-grpc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- StoreAotProcessingTest compiles the code that AOT processing generates. -->
            <groupId>org.springframework</groupId>
            <artifactId>spring-core-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- No main classes, so no jar. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <skipIfEmpty>true</skipIfEmpty>
                </configuration>
            </plugin>
            <plugin>
                <!-- As in the java-module profile: exposes ${org.mockito:mockito-core:jar} for the agent argument. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dependency-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- As in the java-module profile: sets synapse.mockitoAgentArg to Mockito's -javaagent, so Mockito
                     runs as an agent instead of attaching itself at run time (parent/synapse-parent/pom.xml explains
                     the regex). -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>mockito-agent-arg</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>regex-property</goal>
                        </goals>
                        <configuration>
                            <name>synapse.mockitoAgentArg</name>
                            <value>"-javaagent:${org.mockito:mockito-core:jar}"</value>
                            <regex>^"-javaagent:\$\{.*|^(.+)$</regex>
                            <replacement>$1</replacement>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- The java-module profile binds failsafe only in modules with main sources. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
