<!--
    Integration tests for the root build's rules (Maven Enforcer). Each project under src/it inherits the root
    build parent and is built by the maven-invoker-plugin; see its invoker.properties for the expected result.
    Never published.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>synapse-build-rules-tests</artifactId>
    <packaging>pom</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Integration tests for the Synapse build rules. Not published.</description>

    <properties>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- Test scope, never needed by anything but invoker:install, which resolves them in test scope (scope,
             below). They put synapse-parent and synapse-bom in the reactor build order, and invoker:install copies
             them (with their parents) into target/it-repo for the projects that inherit synapse-parent. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-parent</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-bom</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <!-- The same for synapse-core, which the parent-build-config projects depend on. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <configuration>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <!-- An isolated repository that reads from the developer's/CI's local repository (see settings.xml). -->
                    <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
                    <settingsFile>src/it/settings.xml</settingsFile>
                    <properties>
                        <!-- Reads dependencies in place from the main local repository instead of copying them. -->
                        <maven.repo.local.tail>${settings.localRepository}</maven.repo.local.tail>
                    </properties>
                    <parallelThreads>1C</parallelThreads>
                    <postBuildHookScript>verify</postBuildHookScript>
                    <!-- invoker:install installs the dependencies above, which are test scope (default: runtime). -->
                    <scope>test</scope>
                    <!-- What the integration-test builds need beyond what this module's own build resolves. invoker:install
                         resolves each one, with its runtime dependencies, into the main local repository (so CI's cache
                         holds it) and installs it into it-repo. src/it/settings.xml mirrors every repository to the main
                         local repository, so a project that needs anything else fails and names it: add it here. The
                         plugin versions are spring-boot-starter-parent's (what synapse-parent's projects build with). -->
                    <extraArtifacts>
                        <extraArtifact>org.springframework.boot:spring-boot-maven-plugin:${spring-boot.version}:maven-plugin</extraArtifact>
                        <extraArtifact>org.apache.maven.plugins:maven-compiler-plugin:3.15.0:maven-plugin</extraArtifact>
                        <extraArtifact>org.apache.maven.plugins:maven-surefire-plugin:3.5.6:maven-plugin</extraArtifact>
                        <extraArtifact>org.apache.maven.plugins:maven-failsafe-plugin:3.5.6:maven-plugin</extraArtifact>
                        <!-- Surefire's and Failsafe's JUnit provider, which they resolve only when tests run. -->
                        <extraArtifact>org.apache.maven.surefire:surefire-junit-platform:3.5.6:jar</extraArtifact>
                        <!-- And the JUnit Platform launcher it resolves, at Boot's JUnit version, outside dependency
                             management (with jspecify 1.0.0). -->
                        <extraArtifact>org.junit.platform:junit-platform-launcher:6.0.3:jar</extraArtifact>
                        <extraArtifact>org.apache.maven.plugins:maven-install-plugin:3.1.4:maven-plugin</extraArtifact>
                        <extraArtifact>org.apache.maven.plugins:maven-deploy-plugin:3.1.4:maven-plugin</extraArtifact>
                        <extraArtifact>org.apache.maven.plugins:maven-site-plugin:3.12.1:maven-plugin</extraArtifact>
                        <extraArtifact>org.apache.maven.plugins:maven-help-plugin:${maven-help-plugin.version}:maven-plugin</extraArtifact>
                        <!-- banned-junit4-compile: the dependency the build rule must reject. -->
                        <extraArtifact>junit:junit:4.13.2:jar</extraArtifact>
                        <!-- The versions Spring Boot's dependency management gives junit's and Testcontainers' dependencies in
                             those projects (the transitive ones resolved above are the unmanaged versions). -->
                        <extraArtifact>org.hamcrest:hamcrest-core:3.0:jar</extraArtifact>
                        <extraArtifact>commons-codec:commons-codec:1.21.0:jar</extraArtifact>
                        <extraArtifact>org.testcontainers:testcontainers-postgresql:2.0.5:jar</extraArtifact>
                        <extraArtifact>org.junit.jupiter:junit-jupiter:6.0.3:jar</extraArtifact>
                        <!-- bom-guava-pin and parent-effective-pom: the guava BOM a consumer imports, grpc-api (which
                             brings an older guava) and the guava version synapse-bom pins (its CVE pin). -->
                        <extraArtifact>com.google.guava:guava-bom:33.6.0-jre:pom</extraArtifact>
                        <extraArtifact>io.grpc:grpc-api:${grpc-java.version}:jar</extraArtifact>
                        <extraArtifact>com.google.guava:guava:33.7.2-jre:jar</extraArtifact>
                    </extraArtifacts>
                    <streamLogsOnFailures>true</streamLogsOnFailures>
                </configuration>
                <executions>
                    <execution>
                        <id>build-rules</id>
                        <goals>
                            <goal>install</goal>
                            <goal>run</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
