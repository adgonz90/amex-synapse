<?xml version="1.0" encoding="UTF-8"?>
<!--
    A project that inherits synapse-parent and turns a feature profile on with spring.profiles.include in its
    application.yaml. With the parent's aot profile, AOT processing would run with kafka active, so Boot would ignore the
    build environment, the default profile: Synapse fails process-aot instead, naming the profile and the fix.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse-parent</artifactId>
        <version>@project.version@</version>
        <relativePath/>
    </parent>

    <artifactId>parent-aot-include-fails</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-core</artifactId>
            <version>@project.version@</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
