<?xml version="1.0" encoding="UTF-8"?>
<!--
    A project that inherits synapse-parent and builds without the aot profile: Spring AOT processing is opt-in
    (-Paot), so package runs no process-aot, and the project needs no build environment file
    (application-build.yaml). The image settings for build-image stay. verify.groovy checks both, runs the jar, and
    starts it as the image's training run does, which fails without the build environment's file.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse-parent</artifactId>
        <version>@project.version@</version>
        <relativePath/>
    </parent>

    <artifactId>parent-aot-off-by-default</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-core</artifactId>
            <version>@project.version@</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
