<?xml version="1.0" encoding="UTF-8"?>
<!--
    A project that inherits synapse-parent and sets its own argLine property: its options, the Mockito agent and
    -Xshare:off all reach the Surefire and Failsafe JVMs.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse-parent</artifactId>
        <version>@project.version@</version>
        <relativePath/>
    </parent>

    <artifactId>parent-argline-own</artifactId>
    <packaging>jar</packaging>

    <properties>
        <!-- The consumer's own JVM options for its tests, set the way Surefire documents: the argLine property. -->
        <argLine>-Dsynapse.probe=own -Xmx512m</argLine>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-core</artifactId>
            <version>@project.version@</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Bound so the ITs run in Failsafe's JVM, which gets the parent's argLine too. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
