<?xml version="1.0" encoding="UTF-8"?>
<!--
    A service that inherits synapse-parent and has no file for the build environment (application-build.yaml).
    -Pimage package must fail in validate, at the enforcer's image-build-environment check, before any image is
    built: the image's AOT-cache training run would start in that environment and fail. verify.groovy checks the
    message and that no jar or image step ran.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse-parent</artifactId>
        <version>@project.version@</version>
        <relativePath/>
    </parent>

    <artifactId>parent-image-no-build-file</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
