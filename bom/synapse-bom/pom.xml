<!--
    Bill of materials for Synapse artifacts and the third-party libraries Synapse adds beyond Spring Boot.
    Deliberately has no parent and does not import spring-boot-dependencies: consumers get Boot from
    synapse-parent or by importing spring-boot-dependencies themselves.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.americanexpress.synapse</groupId>
    <artifactId>synapse-bom</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>Synapse bill of materials.</description>
    <url>https://github.com/americanexpress/synapse</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>American Express Travel Related Services, Inc.</name>
            <organizationUrl>https://americanexpress.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/americanexpress/synapse</url>
        <connection>scm:git:https://github.com/americanexpress/synapse.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/americanexpress/synapse.git</developerConnection>
    </scm>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.americanexpress.synapse</groupId>
                <artifactId>synapse-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.americanexpress.synapse</groupId>
                <artifactId>synapse-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.americanexpress.synapse</groupId>
                <artifactId>synapse-logging-log4j2</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.americanexpress.synapse</groupId>
                <artifactId>synapse-api-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.americanexpress.synapse</groupId>
                <artifactId>synapse-test-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>1.5.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Lets `./mvnw spotless:apply|check` run from the repo root. Nothing to format here; not inherited. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.10.4</version>
                <inherited>false</inherited>
            </plugin>
        </plugins>
    </build>
</project>
