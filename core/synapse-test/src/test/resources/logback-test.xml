<!-- Test-only logging for synapse-test (never packaged): Boot's console defaults, without ArchUnit's INFO lines. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
    <!-- ArchUnit logs "Detected Java version" at INFO on every import. -->
    <logger name="com.tngtech.archunit" level="WARN"/>
</configuration>
