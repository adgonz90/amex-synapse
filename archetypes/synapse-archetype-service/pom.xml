<!--
    The service archetype: a service in three modules (contract, data, service), served over REST and gRPC on
    PostgreSQL, shaped like samples/reference-bookstore with one aggregate, Item.

        mvn archetype:generate -DarchetypeGroupId=io.americanexpress.synapse \
            -DarchetypeArtifactId=synapse-archetype-service -DarchetypeVersion=<version> -DserviceName=<name>

    serviceName is a lowercase letter followed by lowercase letters and digits (no hyphen, no Java keyword): it names a
    Java package and environment variables. META-INF/archetype-post-generate.groovy fails the generation otherwise
    (src/it tests that).

    The templates are in src/main/resources/archetype-resources. The integration test (projects/s) generates a
    project, builds it with verify (its integration tests need Docker) and checks its files (verify.groovy).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>synapse-archetype-service</artifactId>
    <packaging>maven-archetype</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Maven archetype for a Synapse service in contract, data and service modules, over REST and gRPC on PostgreSQL, shaped like the reference bookstore sample.</description>

    <properties>
        <!-- The synapse-parent version of the generated project: the Synapse release this archetype is released with.
             The template pom.xml files are filtered with @ delimiters only, so @synapse.version@ is replaced at
             archetype build time and the templates' ${...} stays for Velocity. -->
        <synapse.version>${project.version}</synapse.version>
    </properties>

    <!--
        Test scope: these put the modules the generated project uses ahead of this one in the reactor (-am builds
        them). invoker:install below copies them, from the reactor, into target/it-repo.
    -->
    <dependencies>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-parent</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-bom</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-api-rest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-api-rest-openapi</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-api-grpc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-data-jpa</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-data-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-logging-log4j2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test-rest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test-grpc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test-data</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            The IT projects (src/test/resources) are copied to target/it, not target/test-classes, and generated there
            (target/it/projects/s/project/s). Under target/test-classes the generated project's own target/classes
            would match ArchUnit's DO_NOT_INCLUDE_TESTS pattern (.*/target/test-classes/.*), so its ArchitectureTest
            would import no class and fail. This module has no test classes.
        -->
        <testOutputDirectory>${project.build.directory}/it</testOutputDirectory>
        <!-- Maven filtering (@ delimiters only) of the template pom.xml files; every other template is copied as is. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>archetype-resources/**/pom.xml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>archetype-resources/**/pom.xml</exclude>
                </excludes>
            </resource>
        </resources>
        <!-- The IT projects' verify.groovy files get the reactor version (@project.version@). -->
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>projects/*/verify.groovy</include>
                </includes>
            </testResource>
            <testResource>
                <directory>src/test/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>projects/*/verify.groovy</exclude>
                </excludes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <delimiters>
                        <delimiter>@</delimiter>
                    </delimiters>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                </configuration>
            </plugin>
            <!-- Fills target/it-repo with the reactor's Synapse modules that the generated project uses, their parents,
                 and their runtime dependencies (Spring Boot's and the other third-party jars, copied from the main local
                 repository), so the IT never reads or writes a Synapse snapshot in the developer's ~/.m2. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <executions>
                    <execution>
                        <id>it-repo</id>
                        <goals>
                            <goal>install</goal>
                        </goals>
                        <configuration>
                            <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
                            <extraArtifacts>
                                <extraArtifact>io.americanexpress.synapse:synapse-parent:${project.version}:pom</extraArtifact>
                                <extraArtifact>io.americanexpress.synapse:synapse-bom:${project.version}:pom</extraArtifact>
                                <extraArtifact>io.americanexpress.synapse:synapse-api-rest:${project.version}:jar</extraArtifact>
                                <extraArtifact>io.americanexpress.synapse:synapse-api-rest-openapi:${project.version}:jar</extraArtifact>
                                <extraArtifact>io.americanexpress.synapse:synapse-api-grpc:${project.version}:jar</extraArtifact>
                                <extraArtifact>io.americanexpress.synapse:synapse-data-jpa:${project.version}:jar</extraArtifact>
                                <extraArtifact>io.americanexpress.synapse:synapse-data-postgres:${project.version}:jar</extraArtifact>
                                <extraArtifact>io.americanexpress.synapse:synapse-logging-log4j2:${project.version}:jar</extraArtifact>
                                <extraArtifact>io.americanexpress.synapse:synapse-test-rest:${project.version}:jar</extraArtifact>
                                <extraArtifact>io.americanexpress.synapse:synapse-test-grpc:${project.version}:jar</extraArtifact>
                                <extraArtifact>io.americanexpress.synapse:synapse-test-data:${project.version}:jar</extraArtifact>
                                <!-- What the generated project's build needs beyond what this module's build resolves,
                                     resolved (with runtime dependencies) into the main local repository, which CI
                                     caches. src/test/resources/settings.xml mirrors every repository to that
                                     repository, so a generated build that needs anything else fails and names it: add
                                     it here. The plugin versions are spring-boot-starter-parent's; the agent's is the
                                     template's opentelemetry-javaagent.version. -->
                                <extraArtifact>org.springframework.boot:spring-boot-maven-plugin:${spring-boot.version}:maven-plugin</extraArtifact>
                                <extraArtifact>org.apache.maven.plugins:maven-failsafe-plugin:3.5.6:maven-plugin</extraArtifact>
                                <extraArtifact>org.apache.maven.surefire:surefire-junit-platform:3.5.6:jar</extraArtifact>
                                <!-- The JUnit Platform launcher that provider resolves for the tests, at the
                                     JUnit version Boot manages (6.0.3), outside the project's dependency
                                     management. It brings jspecify 1.0.0, which the main build resolves only
                                     when its own tests happen to run first. -->
                                <extraArtifact>org.junit.platform:junit-platform-launcher:6.0.3:jar</extraArtifact>
                                <extraArtifact>org.springframework.boot:spring-boot-starter-actuator:${spring-boot.version}:jar</extraArtifact>
                                <extraArtifact>io.opentelemetry.javaagent:opentelemetry-javaagent:2.33.1:jar</extraArtifact>
                            </extraArtifacts>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- src/it: generation that must fail. Each directory has no pom.xml, so the invoker runs
                             archetype:generate in it with that directory's test.properties (serviceName, artifactId,
                             package), against this archetype from target/it-repo, and verify.groovy reads the log. -->
                        <id>generate-fails</id>
                        <goals>
                            <goal>run</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <projectsDirectory>src/it</projectsDirectory>
                            <cloneProjectsTo>${project.build.directory}/inv</cloneProjectsTo>
                            <pomIncludes>
                                <pomInclude>*</pomInclude>
                            </pomIncludes>
                            <goals>
                                <goal>org.apache.maven.plugins:maven-archetype-plugin:${maven-archetype-plugin.version}:generate</goal>
                            </goals>
                            <properties>
                                <archetypeGroupId>${project.groupId}</archetypeGroupId>
                                <archetypeArtifactId>${project.artifactId}</archetypeArtifactId>
                                <archetypeVersion>${project.version}</archetypeVersion>
                                <groupId>com.example</groupId>
                                <version>0.1.0-SNAPSHOT</version>
                                <interactiveMode>false</interactiveMode>
                                <maven.repo.local.tail>${settings.localRepository}</maven.repo.local.tail>
                            </properties>
                            <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
                            <settingsFile>${project.basedir}/src/test/resources/settings.xml</settingsFile>
                            <postBuildHookScript>verify</postBuildHookScript>
                            <streamLogsOnFailures>true</streamLogsOnFailures>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- archetype:integration-test (integration-test phase): generates each project of target/it/projects
                 (copied from src/test/resources/projects) and runs its goal.txt with target/it-repo as the local
                 repository. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-archetype-plugin</artifactId>
                <configuration>
                    <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
                    <!-- Mirrors the developer's/CI's local repository as a remote one (as the build-rules tests do). -->
                    <settingsFile>${project.basedir}/src/test/resources/settings.xml</settingsFile>
                    <properties>
                        <!-- target/it-repo comes first, so its Synapse modules win; the main local repository serves
                             what it lacks (test libraries, plugins, protoc). -->
                        <maven.repo.local.tail>${settings.localRepository}</maven.repo.local.tail>
                    </properties>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            The generated contract module runs protoc through the protobuf-maven-plugin. On a machine where protoc must
            run from a sanctioned directory (-Dprotobuf.sanctioned-executable-path=<dir>, as the reactor build is given),
            the generated build gets the same property. Without it the generated build uses the plugin's default.
        -->
        <profile>
            <id>protobuf-sanctioned-executable-path</id>
            <activation>
                <property>
                    <name>protobuf.sanctioned-executable-path</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-archetype-plugin</artifactId>
                        <configuration>
                            <properties>
                                <protobuf.sanctioned-executable-path>${protobuf.sanctioned-executable-path}</protobuf.sanctioned-executable-path>
                            </properties>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
