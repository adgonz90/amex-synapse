<!--
    The ${serviceName} service: items served over REST and gRPC from one set of operations, on PostgreSQL. See README.md
    for how to run it.

    contract-${serviceName} holds what callers depend on (the .proto, the classes generated from it, the records and the
    error codes), data-${serviceName} declares the ${serviceName} store (its entity, repository, migrations and settings), and
    service-${serviceName} is the bootable service: the operations, and their REST and gRPC bindings. This aggregator
    inherits synapse-parent, which brings Spring Boot, the Synapse BOM (so no dependency in the modules has a version)
    and the build conventions; every module inherits it from here.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse-parent</artifactId>
        <version>@synapse.version@</version>
        <relativePath/>
    </parent>

    <groupId>${groupId}</groupId>
    <artifactId>${artifactId}</artifactId>
    <version>${version}</version>
    <packaging>pom</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>The ${serviceName} service, over REST and gRPC on PostgreSQL.</description>

    <modules>
        <module>contract-${serviceName}</module>
        <module>data-${serviceName}</module>
        <module>service-${serviceName}</module>
    </modules>
</project>
