<!--
    The bootable service: the operations of the ${serviceName} service, served over REST and gRPC from the same beans, on
    the ${serviceName} store of data-${serviceName}. It inherits synapse-parent through ../pom.xml, so no dependency below
    has a version.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}</artifactId>
        <version>${version}</version>
    </parent>

    <artifactId>service-${serviceName}</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>The bootable ${serviceName} service, over REST and gRPC.</description>

    <properties>
        <!-- spring-boot:run runs the local environment (application-local.yaml); -Dspring-boot.run.profiles=<env>
             picks another. It runs this module alone, so it needs contract-${serviceName} and data-${serviceName}
             installed (./mvnw install from the aggregator). -->
        <spring-boot.run.profiles>local</spring-boot.run.profiles>
        <!-- The OpenTelemetry Java agent that the build copies to target/otel (the otel-agent execution below). Spring
             Boot doesn't manage its version. -->
        <opentelemetry-javaagent.version>2.33.1</opentelemetry-javaagent.version>
        <!-- The agent jar's SHA-256, which the otel-agent-checksum execution checks: the same value as Maven Central's
             opentelemetry-javaagent-2.33.1.jar.sha256 and as the opentelemetry-javaagent.jar of the v2.33.1 GitHub
             release. Change it together with the version. -->
        <opentelemetry-javaagent.sha256>e43a270df53c6f423e0ab157be9c27ccc01d5dc3232e162fe54777573db2f149</opentelemetry-javaagent.sha256>
        <!-- Where the build copies the agent. -->
        <otel-agent.jar>${project.build.directory}/otel/opentelemetry-javaagent.jar</otel-agent.jar>
    </properties>

    <dependencies>
        <!-- The service's own contract: the records the operations take and return, the error codes, and the classes
             generated from ${serviceName}.proto. -->
        <dependency>
            <groupId>${groupId}</groupId>
            <artifactId>contract-${serviceName}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The ${serviceName} store: its entity, repository, migrations and settings. It brings JPA and PostgreSQL. -->
        <dependency>
            <groupId>${groupId}</groupId>
            <artifactId>data-${serviceName}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The REST plugin: Spring MVC on Tomcat (port 8080), the Synapse edge and the operation pipeline
             (synapse-core). -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-api-rest</artifactId>
        </dependency>
        <!-- The OpenAPI document of the REST routes, at /v3/api-docs. It is off unless springdoc.api-docs.enabled is
             true, which only application-local.yaml sets. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-api-rest-openapi</artifactId>
        </dependency>
        <!-- The gRPC plugin: Spring Boot's gRPC server on Netty (port 9090), the Synapse edge, and the protobuf and
             grpc-java runtime with the reflection and health services. Both plugins call the same operations. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-api-grpc</artifactId>
        </dependency>
        <!-- The store's access and database. data-${serviceName} brings both already; the service declares them too
             because its operations use JPA and its tests need PostgreSQL, so a change to the data module can't take
             them away silently. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-data-postgres</artifactId>
        </dependency>
        <!-- Prescriptive logging: synchronous Log4j2 with ECS JSON on the console. Logback must be absent, hence the
             spring-boot-starter-logging exclusions below. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-logging-log4j2</artifactId>
        </dependency>
        <!-- Synapse carries the correlation id and context attributes as tracing baggage, so tracing is required. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- /actuator/health with the ${serviceName} store's indicator (db/${serviceName}), the readiness group at
             /health, and Boot's grpc.health.v1.Health service on the gRPC port. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- The REST slice (@SynapseRestTest). -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test-rest</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The gRPC slice (@SynapseGrpcTest). -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test-grpc</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @StoreConnection and SynapseContainers for the integration tests, which run the store on PostgreSQL. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test-data</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- An executable jar: java -jar target/service-${serviceName}-<version>.jar. synapse-parent configures the
                 executions: repackage, and, with -Paot (Spring AOT processing is opt-in), process-aot, which runs in
                 the build environment (application-build.yaml, data-${serviceName}'s config-build.yaml) and puts the
                 generated code in the jar. java -Dspring.aot.enabled=true -jar runs that code instead of the
                 configuration classes. With -Pimage, synapse-parent's image profile also binds build-image-no-fork
                 here, the module that declares this plugin: ./mvnw -Pimage package builds the image
                 service-${serviceName}:<version>. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- The OpenTelemetry Java agent recipe: copies the agent jar to target/otel/opentelemetry-javaagent.jar,
                 for java -javaagent:<it> -jar ..., spring-boot:run with -Potel-agent (below) and ServiceAgentIT. It
                 runs in generate-test-resources, in every build: before the tests, so that ServiceAgentIT always runs,
                 and before test-compile, the phase that spring-boot:run builds to, so that -Potel-agent
                 spring-boot:run works on a fresh checkout. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>otel-agent</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>io.opentelemetry.javaagent</groupId>
                                    <artifactId>opentelemetry-javaagent</artifactId>
                                    <version>${opentelemetry-javaagent.version}</version>
                                    <outputDirectory>${project.build.directory}/otel</outputDirectory>
                                    <destFileName>opentelemetry-javaagent.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Fails the build when the copied agent jar isn't the one pinned by opentelemetry-javaagent.sha256, in the
                 phase after the copy: the JVM runs a -javaagent with full rights, so a different jar must never start.
                 Maven's own repository checksum policy only warns by default. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>otel-agent-checksum</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireFileChecksum>
                                    <file>${otel-agent.jar}</file>
                                    <checksum>${opentelemetry-javaagent.sha256}</checksum>
                                    <type>sha256</type>
                                    <message>The OpenTelemetry Java agent jar (${otel-agent.jar}) doesn't have the SHA-256 in opentelemetry-javaagent.sha256. Don't run it: check where it was downloaded from, or set the checksum of the version you meant to use.</message>
                                </requireFileChecksum>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Runs the *IT classes in the integration-test phase, after package has built the jar (the unit tests,
                 *Test, run in surefire). Most need Docker, for the PostgreSQL container. ServiceAgentIT, ServiceAotIT
                 and ServiceExitOnRefreshIT start the packaged jar itself, whose path they get here (ServiceAgentIT
                 with the agent jar too). ServiceAotIT needs the AOT-generated code, so it runs only with -Paot (the
                 aot profile below). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <service.jar>${project.build.directory}/${project.build.finalName}.jar</service.jar>
                        <service.otel-agent>${otel-agent.jar}</service.otel-agent>
                    </systemPropertyVariables>
                    <excludes>
                        <exclude>**/ServiceAotIT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- spring-boot:run under the OpenTelemetry Java agent, with the agent jar that the otel-agent execution copied
             (spring-boot:run builds to test-compile, after the copy) and every agent exporter off. To export, pass
             -Dspring-boot.run.jvmArguments=... with your otel.*.exporter values: the system properties here win over
             OTEL_* variables. ServiceAgentIT starts the jar with the same options. Not in AOT mode: see
             OpenTelemetryAgentAotConfiguration. -->
        <profile>
            <id>otel-agent</id>
            <properties>
                <spring-boot.run.jvmArguments>-javaagent:${otel-agent.jar} -Dotel.service.name=${serviceName} -Dotel.traces.exporter=none -Dotel.metrics.exporter=none -Dotel.logs.exporter=none</spring-boot.run.jvmArguments>
            </properties>
        </profile>
        <!-- With synapse-parent's aot profile (-Paot), which runs process-aot, failsafe runs ServiceAotIT too. -->
        <profile>
            <id>aot</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <excludes combine.self="override"/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
