<!--
    The contract of the ${serviceName} service: what a caller of the service depends on, whichever protocol it uses. The
    .proto in src/main/proto and the messages and stubs generated from it, the records the operations take and return
    (the REST bodies are these records), and the error codes. It has no Synapse API plugin and no service code, so a
    client (or another service) can depend on it without pulling the service in. It does bring synapse-core (for
    ErrorDetails), and with it Synapse core's dependencies.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}</artifactId>
        <version>${version}</version>
    </parent>

    <artifactId>contract-${serviceName}</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>The contract of the ${serviceName} service (proto, records, error codes).</description>

    <dependencies>
        <!-- The generated messages (protobuf-java) and the ItemServiceGrpc stubs (grpc-stub, grpc-protobuf). -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <!-- The constraints on the request records (@NotBlank, @Size), which the operation pipeline checks on every
             protocol. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- ErrorDetails for ItemErrors, and JSpecify's @Nullable. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generates the messages and the ItemServiceGrpc stubs from src/main/proto (the plugin's default source
                 directory) into target/generated-sources. spring-boot-starter-parent, and so synapse-parent,
                 configures protoc, the grpc-java plugin and the generate execution. -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
