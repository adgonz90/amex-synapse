<!--
    The books store: @SynapseDataStore("books") on JPA, its entity and repository, its Flyway migrations in
    db/migration/books, and its settings in META-INF/synapse. A service gets the store by depending on this module;
    it configures nothing else. The module knows nothing of the contract: the service's operations map its entity to
    the contract's records.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse.samples</groupId>
        <artifactId>reference-bookstore</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>data-books</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Sample: the books store of the reference bookstore (JPA on PostgreSQL). Not published.</description>

    <dependencies>
        <!-- JPA access: a Hibernate EntityManagerFactory, a JPA transaction manager and Spring Data JPA repositories
             for the store, with the entity bases (AuditedEntity). It brings synapse-data-core: the pool, Flyway per
             store, health and the store checks. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-data-jpa</artifactId>
        </dependency>
        <!-- The store's database is PostgreSQL: the driver, Flyway's PostgreSQL support (flyway-database-postgresql)
             and the PostgreSQL dialects. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-data-postgres</artifactId>
        </dependency>

        <!-- @SynapseDataTest, @StoreConnection and SynapseContainers (Testcontainers' PostgreSQL). -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test-data</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Runs the *IT classes in the verify phase. They need Docker, for the PostgreSQL container. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
