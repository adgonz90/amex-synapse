<!--
    A runnable REST service built with Synapse: a small book catalog. See README.md for how to run it.

    It inherits the root build parent so that it goes through the same gates as the library modules. A real service
    inherits io.americanexpress.synapse:synapse-parent instead; the dependencies below are declared exactly as such a
    service would declare them. Never published.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>synapse-sample-rest-books</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Sample: a book catalog served over REST with Synapse. Not published.</description>

    <properties>
        <!-- A sample: never installed or deployed (which also keeps it out of the release SBOM), and no source or
             Javadoc jars. -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <!-- ./mvnw spring-boot:run runs the local environment (application-local.yaml);
             -Dspring-boot.run.profiles=<env> picks another. -->
        <spring-boot.run.profiles>local</spring-boot.run.profiles>
    </properties>

    <dependencies>
        <!-- The REST plugin: Spring MVC on Tomcat, the Synapse edge and the operation pipeline (synapse-core). -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-api-rest</artifactId>
        </dependency>
        <!-- Prescriptive logging: synchronous Log4j2 with ECS JSON on the console. Logback must be absent, hence the
             spring-boot-starter-logging exclusions below. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-logging-log4j2</artifactId>
        </dependency>
        <!-- Synapse carries the correlation id and context attributes as tracing baggage, so tracing is required. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- /actuator/health. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test-rest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- An executable jar: java -jar target/synapse-sample-rest-books-<version>.jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>io.americanexpress.synapse.samples.books.BooksApplication</mainClass>
                </configuration>
            </plugin>
            <!-- The integration tests run against the classes, not the repackaged jar (whose classes are under
                 BOOT-INF/classes, where Spring can't find them). spring-boot-starter-parent, and so synapse-parent, sets
                 this for a real service. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
