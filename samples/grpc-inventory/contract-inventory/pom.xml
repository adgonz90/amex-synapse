<!--
    The inventory's contract: what a caller of the service depends on. The .proto in src/main/proto and the messages
    and stubs generated from it, the records the operations take and return, and the error codes. It has no Synapse
    API plugin and no service code, so a client (or another service) can depend on it without pulling the service in.
    It does bring synapse-core (for ErrorDetails and PageQuery), and with it Synapse core's dependencies.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse.samples</groupId>
        <artifactId>grpc-inventory</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>contract-inventory</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Sample: the contract of the gRPC inventory (proto, records, error codes). Not published.</description>

    <dependencies>
        <!-- The generated messages (protobuf-java) and the InventoryServiceGrpc stubs (grpc-stub, grpc-protobuf). -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <!-- The constraints on the request records (@NotBlank, @Valid), which the operation pipeline checks. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- ErrorDetails for InventoryErrors, PageQuery for ListItemsRequest, and JSpecify's @Nullable. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generates the messages and the InventoryServiceGrpc stubs from src/main/proto (the plugin's default
                 source directory) into target/generated-sources. spring-boot-starter-parent, and so synapse-parent,
                 configures protoc, the grpc-java plugin and the generate execution. -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
