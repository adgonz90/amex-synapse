<!--
    The gRPC tour: a stock inventory served over gRPC, in memory. See README.md for how to run it.

    A service in two modules, as a real Synapse service is laid out: contract-inventory holds what callers depend on
    (the .proto, the classes generated from it, the records and the error codes), and service-inventory holds the
    operations, the store and the gRPC bindings. This aggregator inherits synapse-parent, which brings Spring Boot, the
    Synapse BOM (so no dependency in the modules has a version) and the build conventions; both modules inherit it from
    here. The only parts that are not what a service would have are the skip properties, which keep the sample from
    being published.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../../parent/synapse-parent</relativePath>
    </parent>

    <groupId>io.americanexpress.synapse.samples</groupId>
    <artifactId>grpc-inventory</artifactId>
    <packaging>pom</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Sample: the gRPC tour, a stock inventory served over gRPC with Synapse. Not published.</description>

    <modules>
        <module>contract-inventory</module>
        <module>service-inventory</module>
    </modules>

    <properties>
        <!-- A sample: never installed or deployed, and no source or Javadoc jars. A real service drops these four. -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>
</project>
