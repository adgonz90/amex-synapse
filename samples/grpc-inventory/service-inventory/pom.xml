<!--
    The bootable service: the operations, the in-memory store and the gRPC bindings of the inventory. See ../README.md
    for how to run it. It inherits synapse-parent through ../pom.xml, so no dependency below has a version.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse.samples</groupId>
        <artifactId>grpc-inventory</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>service-inventory</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Sample: the bootable gRPC inventory service. Not published.</description>

    <properties>
        <!-- spring-boot:run runs the local environment (application-local.yaml); -Dspring-boot.run.profiles=<env>
             picks another. It runs this module alone, so it needs contract-inventory installed: in a service of your
             own it is; this sample skips install, so run it with java -jar (README.md). -->
        <spring-boot.run.profiles>local</spring-boot.run.profiles>
    </properties>

    <dependencies>
        <!-- The service's own contract: the .proto's generated classes, the records and the error codes. -->
        <dependency>
            <groupId>io.americanexpress.synapse.samples</groupId>
            <artifactId>contract-inventory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The gRPC plugin: Spring Boot's gRPC server on Netty (port 9090), the Synapse edge and the operation pipeline
             (synapse-core), with the protobuf and grpc-java runtime and the reflection and health services. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-api-grpc</artifactId>
        </dependency>
        <!-- Prescriptive logging: synchronous Log4j2 with ECS JSON on the console. Logback must be absent, hence the
             spring-boot-starter-logging exclusions below. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-logging-log4j2</artifactId>
        </dependency>
        <!-- Synapse carries the correlation id and context attributes as tracing baggage, so tracing is required. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Health: Boot's grpc.health.v1.Health service reports the actuator's health. There is no web server, so
             there is no /actuator over HTTP. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test-grpc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- InventoryGrpcTest launches a deliberately failing slice test with JUnit's EngineTestKit. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- An executable jar: java -jar target/service-inventory-<version>.jar. synapse-parent configures the
                 executions (repackage). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Runs the *IT classes in the verify phase (the unit tests, *Test, run in surefire). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
