<!--
    The bootable service: the operations and the REST bindings of the orders service, over the two stores of
    data-orders and data-ledger. See ../README.md for how to run it. It inherits synapse-parent through ../pom.xml, so
    no dependency below has a version.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse.samples</groupId>
        <artifactId>multi-store</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>service-orders</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Sample: the bootable orders service of multi-store. Not published.</description>

    <properties>
        <!-- spring-boot:run runs the local environment (application-local.yaml); -Dspring-boot.run.profiles=<env>
             picks another. It runs this module alone, so it needs the data modules installed: in a service of your
             own they are; this sample skips install, so run it with java -jar (README.md). -->
        <spring-boot.run.profiles>local</spring-boot.run.profiles>
    </properties>

    <dependencies>
        <!-- The two stores: each data module brings its store, its access module (JPA or JDBC) and PostgreSQL. -->
        <dependency>
            <groupId>io.americanexpress.synapse.samples</groupId>
            <artifactId>data-orders</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.americanexpress.synapse.samples</groupId>
            <artifactId>data-ledger</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The REST plugin: Spring MVC on Tomcat, the Synapse edge and the operation pipeline (synapse-core). -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-api-rest</artifactId>
        </dependency>
        <!-- Prescriptive logging: synchronous Log4j2 with ECS JSON on the console. Logback must be absent, hence the
             spring-boot-starter-logging exclusions below. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-logging-log4j2</artifactId>
        </dependency>
        <!-- Synapse carries the correlation id and context attributes as tracing baggage, so tracing is required. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- /actuator/health with one indicator per store (db/orders, db/ledger), and the readiness group at /health. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test-rest</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @StoreConnection and SynapseContainers for the integration tests, which run both stores on PostgreSQL. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test-data</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- An executable jar: java -jar target/service-orders-<version>.jar. synapse-parent configures the
                 executions (repackage). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Runs the *IT classes in the verify phase (the unit tests, *Test, run in surefire). Most need Docker, for
                 the PostgreSQL containers. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
