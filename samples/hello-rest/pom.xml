<!--
    The quick start: one greeting over REST. See README.md for how to run it.

    This is the pom of a real Synapse service: it inherits synapse-parent, which brings Spring Boot, the Synapse BOM
    (so no dependency below has a version) and the build conventions. The only parts that are not what a service would
    have are the skip properties, which keep the sample from being published.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.americanexpress.synapse</groupId>
        <artifactId>synapse-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../../parent/synapse-parent</relativePath>
    </parent>

    <groupId>io.americanexpress.synapse.samples</groupId>
    <artifactId>hello-rest</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Sample: the quick start, one greeting over REST with Synapse. Not published.</description>

    <properties>
        <!-- A sample: never installed or deployed, and no source or Javadoc jars. A real service drops these four. -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <!-- ./mvnw spring-boot:run runs the local environment (application-local.yaml);
             -Dspring-boot.run.profiles=<env> picks another. -->
        <spring-boot.run.profiles>local</spring-boot.run.profiles>
    </properties>

    <dependencies>
        <!-- The REST plugin: Spring MVC on Tomcat, the Synapse edge and the operation pipeline (synapse-core). -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-api-rest</artifactId>
        </dependency>
        <!-- Prescriptive logging: synchronous Log4j2 with ECS JSON on the console. Logback must be absent, hence the
             spring-boot-starter-logging exclusions below. -->
        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-logging-log4j2</artifactId>
        </dependency>
        <!-- Synapse carries the correlation id and context attributes as tracing baggage, so tracing is required. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- /actuator/health. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>io.americanexpress.synapse</groupId>
            <artifactId>synapse-test-rest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- An executable jar: java -jar target/hello-rest-<version>.jar. synapse-parent configures the executions
                 (repackage). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Runs the *IT classes in the verify phase (the unit tests, *Test, run in surefire). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
